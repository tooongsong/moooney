# Where the SQLite database file lives (created automatically on first run)
DATABASE_PATH=./data/app.db

# Required — used to parse text/receipts into transactions.
# Works with OpenAI or any OpenAI-compatible endpoint (set OPENAI_BASE_URL to switch providers).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Optional — locks the app behind a PIN screen. Leave both blank to run with no lock at all
# (fine for a purely local app). If you set APP_PIN, also set APP_SECRET to any random string.
APP_PIN=
APP_SECRET=
