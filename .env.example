# Supabase — find these in your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Postgres — find these in Settings → Database → Connection string
# Use Transaction pooler URL (port 6543) for DATABASE_URL (runtime)
# Use Direct connection URL (port 5432) for DIRECT_URL (drizzle-kit migrations only)
DATABASE_URL=
DIRECT_URL=

# Required — used to parse text/receipts into transactions.
# Works with OpenAI or any OpenAI-compatible endpoint (set OPENAI_BASE_URL to switch providers).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
